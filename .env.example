# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgres://app:app@localhost:5432/seo_tracker

# API HTTP port
PORT=4000

# Session signing secret — must be >= 32 chars (the app fails fast otherwise).
# This local-dev value works out of the box; generate your own for any real deployment.
SESSION_SECRET=dev_local_only_4f8c2a7b1e9d3056_change_in_prod

# Allowed browser origin for CORS in production (dev uses the Vite proxy, same-origin)
WEB_ORIGIN=http://localhost:5173

# Display/filter timezone (the brief states the user is in Toronto)
APP_TIMEZONE=America/Toronto

# Password for the two demo accounts created by `npm run seed` (alex@agency.test,
# sam@agency.test). Local-demo only — change it for any real use.
SEED_PASSWORD=seo-demo-2026
