# ─────────────────────────────────────────────────────────────────────────────
#  Environment configuration
#
#  Copy this file to `.env` and adjust the values below.
#  The real `.env` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by the API, worker, migrations and seed).
DATABASE_URL=postgres://app:app@localhost:5432/seo_tracker

# ── Server ───────────────────────────────────────────────────────────────────
# Port the API listens on (the web dev server proxies /api here).
PORT=4000

# ── Security ─────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Must be at least 32 characters, or the app
# refuses to start. The value below is fine for local development; generate a
# unique random string for any real deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_local_only_4f8c2a7b1e9d3056_change_in_prod

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Allowed browser origin in production (dev uses the Vite proxy, same-origin).
WEB_ORIGIN=http://localhost:5173

# ── Localization ─────────────────────────────────────────────────────────────
# Timezone used to display and filter snapshot dates (the brief states the user
# is in Toronto). Any IANA timezone name is accepted.
APP_TIMEZONE=America/Toronto

# ── Seed ─────────────────────────────────────────────────────────────────────
# REQUIRED before `npm run seed`. This becomes the login password for the two
# demo accounts the seed creates (alex@agency.test, sam@agency.test).
# Choose your own — there is no default, and the seed refuses to run until it is set.
SEED_PASSWORD=
